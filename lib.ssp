// The ASCII spelling of a ligature, letter or punctuation mark that has no diacritic to strip, or
// "" when `c` has none.
fn translit_extra(c: Int) -> Str
= match c
| 160 | 8194 | 8195 | 8199 | 8201 | 8239 => " "
| 161 => "!"
| 8800 => "!="
| 171 | 187 | 8220 | 8221 | 8222 | 8223 | 8243 => "\""
| 8216 | 8217 | 8218 | 8219 | 8242 | 8249 | 8250 => "'"
| 329 => "'n"
| 169 => "(c)"
| 174 => "(r)"
| 8482 => "(tm)"
| 8226 => "*"
| 8208 | 8209 | 8210 | 8211 | 8212 | 8213 | 8722 => "-"
| 8594 => "->"
| 183 => "."
| 8230 => "..."
| 247 => "/"
| 185 => "1"
| 189 => "1/2"
| 188 => "1/4"
| 178 => "2"
| 179 => "3"
| 190 => "3/4"
| 8592 => "<-"
| 8804 => "<="
| 8805 => ">="
| 191 => "?"
| 198 => "AE"
| 208 => "D"
| 8364 => "EUR"
| 163 => "GBP"
| 306 => "IJ"
| 8377 => "INR"
| 165 => "JPY"
| 330 => "N"
| 338 => "OE"
| 182 => "P"
| 167 => "S"
| 7838 => "SS"
| 222 => "TH"
| 230 => "ae"
| 162 => "c"
| 240 => "d"
| 176 => "deg"
| 307 => "ij"
| 312 => "k"
| 331 => "n"
| 339 => "oe"
| 383 => "s"
| 223 => "ss"
| 254 => "th"
| 181 => "u"
| 215 => "x"
| _ => ""

