test accents = strip_accents("Crème Brûlée") == "Creme Brulee" and strip_accents("") == "" and strip_accents("ÀÉÎÕÜçñ") == "AEIOUcn" and strip_accents("Łódź Øre đ") == "Lodz Ore d" and strip_accents("Tiếng Việt") == "Tieng Viet" and strip_accents("e" + cs([769]) + "a" + cs([776])) == "ea" and strip_accents("æß日本") == "æß日本"

test asciis = to_ascii("Æsir straße", "?") == "AEsir strasse" and to_ascii("日本", "?") == "??" and to_ascii("日本", "") == "" and to_ascii(cs([8220]) + "hi" + cs([8221, 8230]), "") == "\"hi\"..." and to_ascii("5 €", "") == "5 EUR" and to_ascii("", "x") == ""

test slugs = slugify("Crème Brûlée & Co.") == "creme-brulee-and-co" and slugify("") == "" and slugify("!!!") == "" and slugify("  Hello,   World!  ") == "hello-world" and slugify("日本") == "" and slugify("Ünïcödé 2026") == "unicode-2026" and slug_options().sep == "-"

test slug_withs = slugify_with("Hello World Again", SlugOptions{sep: "_", max_len: 0, lowercase: false}) == "Hello_World_Again" and slugify_with("hello world again", SlugOptions{sep: "-", max_len: 12, lowercase: true}) == "hello-world" and slugify_with("supercalifragilistic", SlugOptions{sep: "-", max_len: 5, lowercase: true}) == "super" and slugify_with("ab cd", SlugOptions{sep: "-", max_len: 3, lowercase: true}) == "ab"

test unique_slugs = unique_slug("post", []) == "post" and unique_slug("post", ["post"]) == "post-2" and unique_slug("post", ["post", "post-2", "post-4"]) == "post-3" and unique_slug("", [""]) == "-2"

test html = escape_html("<a href=\"x\">Tom & Jerry's</a>") == "&lt;a href=&quot;x&quot;&gt;Tom &amp; Jerry&#39;s&lt;/a&gt;" and escape_html("") == "" and escape_html("日本") == "日本" and escape_xml("'&'") == "&apos;&amp;&apos;"

test unhtml = unescape_html("&lt;p&gt; &amp;amp; &eacute;&#233;&#xE9;&#XE9;") == "<p> &amp; éééé" and unescape_html("&bogus; &#xZZ; & &;") == "&bogus; &#xZZ; & &;" and unescape_html("&#0; &#xD800; &#1114112;") == "&#0; &#xD800; &#1114112;" and unescape_html("&euro;&nbsp;") == cs([8364, 160]) and unescape_html("") == "" and unescape_html("&amp") == "&amp"

test unxml = unescape_xml("&lt;&apos;&quot;&#65;") == "<'\"A" and unescape_xml("&eacute;") == "&eacute;" and unescape_html(escape_html("<&>\"'")) == "<&>\"'" and unescape_xml(escape_xml("a<b>&'\"")) == "a<b>&'\""

test json_escapes = escape_json("a\"b\\c\nd\te") == "a\\\"b\\\\c\\nd\\te" and escape_json(cs([1, 31, 8232])) == "\\u0001\\u001f\\u2028" and escape_json("日本/") == "日本/" and quote_json("x") == "\"x\"" and quote_json("") == "\"\""

test json_unescapes = unescape_json("a\\\"b\\\\c\\nd\\u00e9\\/") == some("a\"b\\c\ndé/") and unescape_json("\\ud83d\\ude00") == some(cs([128512])) and unescape_json("\\ud83d") == none and unescape_json("\\ude00") == none and unescape_json("\\x") == none and unescape_json("\\u12") == none and unescape_json("\\") == none and unescape_json("") == some("") and unescape_json("\\u12G4") == none

test json_round = ["", "plain", "quote\"back\\slash", "ctl" + cs([0, 7, 27]), "日本 😀", cs([8232, 8233])].all(x => unescape_json(escape_json(x)) == some(x))

test shells = quote_shell("abc") == "abc" and quote_shell("") == "''" and quote_shell("a b") == "'a b'" and quote_shell("it's") == "'it'\"'\"'s'" and quote_shell("$HOME") == "'$HOME'" and quote_shell("a/b.c:d=e@f%g+h,i-j_k") == "a/b.c:d=e@f%g+h,i-j_k" and quote_shell("日本") == "'日本'"

test regexes = quote_regex("a.b*c") == "a\\.b\\*c" and quote_regex("") == "" and ["a.b", "(x)", "[a-z]+", "^$|?*+.\{}", "a\{2}", "日本.*"].all(x => do
  match regex("^" + quote_regex(x) + "$")
  | ok(r) => r.is_match(x) and not r.is_match(x + "!")
  | err(_) => false)

test csvs = quote_csv("plain") == "plain" and quote_csv("a,b") == "\"a,b\"" and quote_csv("say \"hi\"") == "\"say \"\"hi\"\"\"" and quote_csv("a\nb") == "\"a\nb\"" and quote_csv("") == ""

test percents = percent_encode("a b&c/é~") == "a%20b%26c%2F%C3%A9~" and percent_encode("") == "" and percent_decode("a%20b%26c%2F%C3%A9~") == some("a b&c/é~") and percent_decode("a+b") == some("a+b") and percent_decode("%") == none and percent_decode("%2") == none and percent_decode("%zz") == none and percent_decode("%FF") == none and percent_decode("%e6%97%a5") == some("日")

test percent_round = ["", "abc", "日本 語?&=#", "😀", "100%"].all(x => percent_decode(percent_encode(x)) == some(x))

test huge_inputs = do
  big = "ab".repeat(50000)
  grapheme_count(big) == 100000 and count_matches(big, "ab") == 50000 and to_snake(big).len == 100000 and display_width(big) == 100000 and reverse_graphemes(big).take(2) == "ba" and levenshtein_within(big, big + "x", 0) == none and slugify(big).len == 100000 and wrap_lines("word ".repeat(20000), 80, false).len == 1250

test huge_escapes = do
  big = "<a&b>\"".repeat(20000)
  unescape_html(escape_html(big)) == big and unescape_json(escape_json(big)) == some(big) and percent_decode(percent_encode(big)) == some(big) and lines("x\n".repeat(50000)).len == 50000 and case_words("fooBar ".repeat(20000)).len == 40000 and replace_each(big, [("<", "["), (">", "]")]).len == big.len and indexes_of(big, "&").len == 20000 and split_any_keep(big, "&").len == 20001

